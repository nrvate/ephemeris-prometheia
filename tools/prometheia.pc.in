# The install-time copy: paths are relative to this file
# (<prefix>/lib/pkgconfig/prometheia.pc). The build-tree copy comes from
# prometheia.pc.build.in instead, with absolute paths to the build.
prefix=${pcfiledir}/../..
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: prometheia
Description: Ephemeris Prometheia: cleanroom solar-system ephemeris (C++20 library with a C interface)
Version: @PROJECT_VERSION@
Requires: libzstd
Libs: -L${libdir} -lprometheia -lstdc++ -lm
Cflags: -I${includedir}
