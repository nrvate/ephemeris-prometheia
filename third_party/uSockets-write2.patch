--- a/src/socket.c
+++ b/src/socket.c
@@ -164,6 +164,11 @@
 
     int written = bsd_write2(us_poll_fd(&s->p), header, header_length, payload, payload_length);
     if (written != header_length + payload_length) {
+        /* ASTROLOG PATCH (EPHEMERIS_REVIEW.md S2): us_socket_write sets this
+         * and this did not, so a partial write made from inside on_writable
+         * had its WRITABLE poll turned straight back off by loop.c and the
+         * buffered tail was never sent. */
+        s->context->loop->data.last_write_failed = 1;
         us_poll_change(&s->p, s->context->loop, LIBUS_SOCKET_READABLE | LIBUS_SOCKET_WRITABLE);
     }
 
